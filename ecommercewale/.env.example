# Server-only variables. Configure them in Vercel Settings > Environment Variables.
# Without database configuration, the website explicitly runs as a local demo.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also supported, server-side only.
ADMIN_PASSWORD=
# At least 32 random characters. Required for signed admin sessions.
SESSION_SECRET=
# Change only after configuring catalogue, service areas and policies.
ACCEPT_ENQUIRIES=false
PORT=3000
